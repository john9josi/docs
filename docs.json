{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Ulysses Docs",
  "colors": {
    "primary": "#0F3D3E",
    "light": "#1F6F70",
    "dark": "#0A2A2B"
  },
  "favicon": "/logo/pinecone-mark.png",
  "appearance": {
    "default": "light",
    "strict": true
  },
  "fonts": {
    "heading": {
      "family": "Newsreader",
      "weight": 500
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.tryulysses.com"
    }
  },
  "navigation": {
    "pages": [
      {
        "group": "Get started",
        "pages": [
          "introduction",
          "quickstart",
          "use-cases/overview",
          "roadmap"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/overview"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/overview",
          "guides/create-a-project",
          "guides/match-opportunities"
        ]
      },
      {
        "group": "Interfaces",
        "pages": [
          "interfaces/web-app",
          "interfaces/cli",
          "interfaces/mcp"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://docs.tryulysses.com/"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@tryulysses.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open app",
      "href": "https://app.tryulysses.com"
    }
  },
  "redirects": [
    {
      "source": "/cli/install",
      "destination": "/interfaces/cli"
    },
    {
      "source": "/cli/auth",
      "destination": "/interfaces/cli"
    },
    {
      "source": "/cli/commands",
      "destination": "/interfaces/cli"
    },
    {
      "source": "/cli/agents",
      "destination": "/interfaces/cli"
    }
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/tryulysses",
      "github": "https://github.com/UlyssesBusinessCorporation"
    }
  }
}
